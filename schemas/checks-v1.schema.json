{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lab/checks-v1.schema.json",
  "title": "Lab Checks v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "checks"],
  "properties": {
    "schema_version": {"const": "lab.checks.v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3}$"},
          "description": {"type": "string", "minLength": 1},
          "status": {"enum": ["pending", "running", "pass", "fail", "blocked", "not_applicable"]},
          "evidence": {"type": "array"}
        }
      }
    }
  }
}
