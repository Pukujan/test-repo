{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lab/experiment-v1.schema.json",
  "title": "Lab Experiment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project", "title", "created_at", "question", "upstream", "source_refs"],
  "properties": {
    "schema_version": {"const": "lab.experiment.v1"},
    "id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "question": {"type": "string", "minLength": 1},
    "upstream": {"type": "array", "items": {"type": "object"}},
    "source_refs": {"type": "array", "items": {"type": "string"}}
  }
}
